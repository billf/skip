{
  "name": "skip-convex-tanstack-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "convex dev --start 'npm run dev:local'",
    "predev:local": "npm run build --workspace=@skip-adapter/convex",
    "dev:local": "concurrently --kill-others-on-fail --names skip,web 'npm:skip:dev' 'npm:web:dev'",
    "skip:dev": "tsx watch skip/server.ts",
    "web:dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "pretypecheck": "npm run build --workspace=@skip-adapter/convex",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --workspace=@skip-adapter/convex",
    "test": "tsx --test skip/service.test.ts"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@skip-adapter/convex": "0.0.23",
    "@skipruntime/core": "^0.0.23",
    "@skipruntime/server": "^0.0.23",
    "@skipruntime/wasm": "^0.0.23",
    "@tanstack/db": "^0.8.7",
    "@tanstack/react-db": "^0.3.7",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.49",
    "convex": "^1.45.0",
    "dotenv": "^17.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
