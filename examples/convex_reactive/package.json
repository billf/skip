{
  "name": "skip-convex-reactive-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'npm run dev:local'",
    "dev:local": "concurrently --kill-others-on-fail --names skip,web 'npm:skip:dev' 'npm:web:dev'",
    "skip:dev": "tsx watch skip/server.ts",
    "web:dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test skip/convex_external_service.test.ts"
  },
  "dependencies": {
    "@skipruntime/core": "^0.0.23",
    "@skipruntime/server": "^0.0.23",
    "@skipruntime/wasm": "^0.0.23",
    "convex": "^1.45.0",
    "dotenv": "^17.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
