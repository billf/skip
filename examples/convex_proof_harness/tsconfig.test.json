{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"resolveJsonModule": true,
		"tsBuildInfoFile": "tsconfig.test.tsbuildinfo",
		// Widened from @skiplabs/tsconfig's "${configDir}/src" so run.ts's
		// conformance scenario can import skipruntime-ts/server/src/rest.ts
		// by workspace-relative path (U11's Approach); harmless with
		// noEmit:true, which never computes emit output paths from this.
		"rootDir": "${configDir}/../.."
	},
	"exclude": [],
	"include": ["src/**/*.ts", "reference/**/*.ts"]
}
