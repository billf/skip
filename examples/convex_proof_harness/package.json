{
  "name": "skip-convex-proof-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.test.tsbuildinfo",
    "lint": "eslint",
    "test": "npm run typecheck && tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "reference:snapshot": "tsx reference/run.ts snapshot",
    "reference:revision": "tsx reference/run.ts revision"
  },
  "author": "SkipLabs",
  "license": "MIT",
  "description": "Provisional correctness-comparator and fault-injection harness for the shared Skip/Convex proof vehicle",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@skip-adapter/atomic-batch": "0.0.23",
    "@skipruntime/core": "0.0.23",
    "@skipruntime/wasm": "0.0.23",
    "convex": "^1.45.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.23.13"
  }
}
